{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "/path/to/opencode-permission-gate",
      "options": {
        "mode": "off",
        "model": "session",
        // Only used with a fixed provider/model.
        "variant": "low",
        "timeout_ms": 2500,
        "on_danger": "deny",
        "on_ask": "ask",
        "on_failure": "ask",
        "language": "Japanese",
        "cache_ttl_ms": 600000,
        // Must be an absolute path.
        "audit_path": "/absolute/path/to/permission-gate.jsonl",
        "auto_agents": ["worker"],
        "inherit_to_child_sessions": true,
        "skip_actions": ["question", "external_directory", "subagent"],
        "force_ask_patterns": ["\\bterraform\\s+destroy\\b", "\\bkubectl\\s+delete\\b"],
      },
    },
  ],
}
